---
import Base from "../layouts/Base.astro";
import GalleryApp from "../components/GalleryApp";
---

<Base
  active="pets"
  title="Pet Gallery — Codogotchi marketplace"
  description="Browse and install community-crafted Codogotchi pets. One command and your new companion is ready."
>
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-12 pb-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-5">
      <div class="max-w-2xl flex flex-col gap-2">
        <div
          class="inline-flex items-center gap-2 w-max bg-gold-leaf/20 border-2 border-gold-leaf text-on-secondary-fixed-variant px-3 py-1 rounded-full text-xs font-bold -rotate-2"
        >
          <span class="material-symbols-outlined text-[14px] text-gold-leaf">auto_awesome</span>
          Community pets ✨
        </div>
        <h1 class="font-display text-3xl md:text-4xl font-extrabold text-on-surface">
          Pet gallery
        </h1>
        <p class="text-on-surface-variant">
          Browse chibi companions crafted by other developers. Install with one
          <code class="font-mono text-sm text-primary">npx codogotchi add &lt;id&gt;</code>
          and switch in <strong>Settings → Pet</strong>.
        </p>
      </div>
    </div>
  </section>

  <div class="squiggle max-w-7xl mx-auto w-full opacity-50 my-4"></div>

  <GalleryApp client:only="react" />

  <!-- Footer disclaimer -->
  <footer class="max-w-7xl mx-auto px-6 pb-10 mt-6">
    <p class="text-xs text-on-surface-variant text-center leading-relaxed">
      Pets in this gallery are community-shared and may be inspired by existing characters or brands.
      Codogotchi does not claim rights to any character designs shown here.
    </p>
  </footer>
</Base>
