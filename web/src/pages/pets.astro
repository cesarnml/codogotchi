---
import Base from "../layouts/Base.astro";

// Pets shown in the gallery. Maew is the real default pet that ships with the
// app; the rest are illustrative community examples for the showcase.
const pets = [
  {
    name: "Maew",
    author: "ships with the app",
    emoji: "👧",
    likes: "—",
    tags: ["Person", "Default"],
    official: true,
    hatched: false,
    id: "maew",
  },
  {
    name: "Boba",
    author: "@dev_jasmine",
    emoji: "🐱",
    likes: "1.2k",
    tags: ["Animal", "Lazy"],
    hatched: true,
    id: "boba",
  },
  {
    name: "Mochi",
    author: "@code_doge",
    emoji: "🐕",
    likes: "856",
    tags: ["Animal", "Active"],
    hatched: true,
    id: "mochi",
  },
  {
    name: "Byte",
    author: "@robo_smith",
    emoji: "🤖",
    likes: "432",
    tags: ["Creature", "Smart"],
    hatched: true,
    id: "byte",
  },
  {
    name: "Pim",
    author: "@nin_codes",
    emoji: "🌶️",
    likes: "318",
    tags: ["Object", "Spicy"],
    hatched: true,
    id: "pim",
  },
  {
    name: "Nim",
    author: "@cloudwalker",
    emoji: "☁️",
    likes: "289",
    tags: ["Creature", "Sleepy"],
    hatched: true,
    id: "nim",
  },
  {
    name: "Tofu",
    author: "@plushdev",
    emoji: "🧋",
    likes: "204",
    tags: ["Object", "Cozy"],
    hatched: true,
    id: "tofu",
  },
  {
    name: "Kao",
    author: "@riceball",
    emoji: "🍙",
    likes: "167",
    tags: ["Object", "Cute"],
    hatched: false,
    id: "kao",
  },
];

const filters = ["All", "Animal", "Person", "Creature", "Object"];
const tabs = ["Newest", "Popular", "Random"];
---

<Base
  active="pets"
  title="Adopt a Codogotchi — community pet gallery"
  description="Browse Codogotchi pets hatched and hand-drawn by developers. Drop one into ~/.codogotchi/pets/ and switch to it in Settings → Pet."
>
  <section class="max-w-7xl mx-auto px-6 pt-12 pb-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-5">
      <div class="max-w-2xl flex flex-col gap-2">
        <div
          class="inline-flex items-center gap-2 w-max bg-gold-leaf/20 border-2 border-gold-leaf text-on-secondary-fixed-variant px-3 py-1 rounded-full text-xs font-bold -rotate-2"
        >
          <span class="material-symbols-outlined text-[14px] text-gold-leaf">auto_awesome</span>
          Hatched with AI ✨
        </div>
        <h1 class="font-display text-3xl md:text-4xl font-extrabold text-on-surface">
          Community pet gallery
        </h1>
        <p class="text-on-surface-variant">
          Adopt chibi companions hatched and hand-drawn by other developers.
          Today, adopting means dropping a pet folder into
          <code class="font-mono text-sm text-primary">~/.codogotchi/pets/</code> and switching
          to it in <strong>Settings → Pet</strong>. A one-line registry is on the way.
        </p>
      </div>
      <button
        class="squishy-btn bg-surface-container-lowest text-primary font-display font-bold px-5 py-3 rounded-xl flex items-center gap-2 rotate-1"
      >
        <span class="material-symbols-outlined">upload</span>
        Submit your pet
      </button>
    </div>
  </section>

  <div class="squiggle max-w-7xl mx-auto w-full opacity-50 my-4"></div>

  <!-- Controls -->
  <section class="max-w-7xl mx-auto px-6 flex flex-col gap-5">
    <div class="flex flex-col md:flex-row justify-between gap-4">
      <div class="relative w-full md:w-96">
        <span
          class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-charcoal-ink"
          >search</span
        >
        <input
          type="text"
          placeholder="Search by name, species, or creator…"
          class="w-full bg-surface-container-lowest border-2 border-charcoal-ink rounded-xl py-3 pl-10 pr-4 placeholder-on-surface-variant focus:outline-none focus:border-secondary-container"
        />
      </div>
      <div class="flex p-1 bg-surface-variant rounded-xl border-2 border-charcoal-ink w-max">
        {
          tabs.map((t, i) => (
            <button
              class={`px-5 py-2 rounded-lg font-bold text-sm ${i === 0 ? "bg-surface-container-lowest text-primary border-2 border-charcoal-ink shadow-[2px_2px_0_0_var(--color-charcoal-ink)]" : "text-on-surface-variant"}`}
            >
              {t}
            </button>
          ))
        }
      </div>
    </div>
    <div class="flex flex-wrap gap-2 items-center">
      <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant mr-1">Filters:</span>
      {
        filters.map((f, i) => (
          <button
            class={`px-4 py-1.5 rounded-full font-medium text-sm border-2 border-charcoal-ink ${i === 0 ? "bg-charcoal-ink text-surface-container-lowest" : "bg-surface-container-lowest hover:bg-surface-container"}`}
          >
            {f}
          </button>
        ))
      }
    </div>
  </section>

  <!-- Grid -->
  <section class="max-w-7xl mx-auto px-6 py-8 grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    {
      pets.map((p, idx) => (
        <article
          class={`sticker-card sticker-card-hover bg-surface-container-lowest rounded-2xl p-3 flex flex-col gap-3 group relative ${idx % 2 ? "-rotate-1" : "rotate-1"}`}
        >
          <div class="menubar-inset rounded-xl h-44 flex items-center justify-center relative overflow-hidden">
            <span class="text-6xl group-hover:scale-110 transition-transform">{p.emoji}</span>
            {p.hatched && (
              <span class="absolute top-2 right-2 text-[10px] font-bold bg-gold-leaf/90 text-on-secondary-fixed border border-charcoal-ink px-1.5 py-0.5 rounded-full">
                AI ✨
              </span>
            )}
            {p.official && (
              <span class="absolute top-2 left-2 text-[10px] font-bold bg-primary-container text-on-primary-container border border-charcoal-ink px-1.5 py-0.5 rounded-full">
                Default
              </span>
            )}
          </div>
          <div class="px-1 flex justify-between items-start">
            <div>
              <h3 class="font-display text-lg font-bold leading-tight">{p.name}</h3>
              <p class="text-sm text-on-surface-variant">by {p.author}</p>
            </div>
            <div class="flex items-center gap-1 bg-surface-container rounded-full px-2 py-1 border border-outline-variant">
              <span class="material-symbols-outlined fill text-error text-[16px]">favorite</span>
              <span class="text-sm font-medium">{p.likes}</span>
            </div>
          </div>
          <div class="px-1 flex gap-1 flex-wrap">
            {p.tags.map((t) => (
              <span class="bg-jade-sage/30 text-charcoal-ink text-xs font-bold px-2 py-0.5 rounded-md border border-charcoal-ink/30">
                {t}
              </span>
            ))}
          </div>
        </article>
      ))
    }
  </section>

  <!-- How adoption works -->
  <section class="max-w-3xl mx-auto px-6 pb-8">
    <div class="sticker-card bg-surface-container rounded-2xl p-6">
      <h3 class="font-display text-lg font-bold mb-3 flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">pets</span>
        How adoption works today
      </h3>
      <div class="menubar-inset rounded-xl p-4 font-mono text-sm text-jade-sage overflow-x-auto leading-relaxed">
        <div><span class="text-white/40"># 1. drop the pet folder into your local pets dir</span></div>
        <div>cp -R ./boba <span class="text-blush-pink">~/.codogotchi/pets/</span></div>
        <div class="mt-2"><span class="text-white/40"># 2. Settings → Pet → choose "Boba" → restart Codogotchi</span></div>
      </div>
      <p class="text-sm text-on-surface-variant mt-3">
        A community registry with a one-line <code class="font-mono">adopt</code> command is
        planned for the RPG release.
      </p>
    </div>
  </section>
</Base>
