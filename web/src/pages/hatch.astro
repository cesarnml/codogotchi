---
import Base from "../layouts/Base.astro";

const steps = [
  {
    n: 1,
    title: "Install the plugin",
    body: "Point Codex at the plugin in the repo and ask it to install hatch-codogotchi and its skills.",
  },
  {
    n: 2,
    title: "Give a starting point",
    body: "A text description, an existing Codex pet from ~/.codex/pets, or a seed image.",
  },
  {
    n: 3,
    title: "Codex generates rows",
    body: "Frames are drawn one row at a time with image_gen and self-validated.",
  },
  {
    n: 4,
    title: "Restart Codogotchi",
    body: "It installs to ~/.codogotchi/pets/<id>/. Your pet is alive.",
  },
];

const prompts = [
  {
    icon: "chat",
    title: "From a text description",
    copy: 'Use the hatch-codogotchi-codex-and-lite-basic skill.\nHatch a new Codogotchi named "Mochi" from this description: a chibi orange tabby in a tiny yellow hoodie, round head, warm pastel palette. Plush style.',
  },
  {
    icon: "pets",
    title: "From an existing Codex pet",
    copy: "Use the hatch-codogotchi-lite-basic skill.\nHatch a Codogotchi from my existing Codex pet in ~/.codex/pets/<pet-name>.",
  },
  {
    icon: "image",
    title: "From a seed image",
    copy: 'Use the hatch-codogotchi-codex-and-lite-basic skill.\nHatch a new Codogotchi named "Mochi" from this seed image.',
  },
];

const skills = [
  {
    name: "hatch-codogotchi-codex-and-lite-basic",
    from: "Description or seed image",
    makes: "Codex + Lite-Basic",
  },
  {
    name: "hatch-codogotchi-codex-and-lite-full",
    from: "Description or seed image",
    makes: "Codex + Lite-Basic + Lite-Enhanced",
  },
  {
    name: "hatch-codogotchi-lite-basic",
    from: "Existing Codex spritesheet",
    makes: "Lite-Basic",
  },
  {
    name: "hatch-codogotchi-lite-enhanced",
    from: "Codex + Lite-Basic",
    makes: "Lite-Enhanced",
  },
  {
    name: "hatch-codogotchi-soa",
    from: "Existing Codex spritesheet",
    makes: "Son-of-Anton delivery gates",
  },
];
---

<Base
  active="hatch"
  title="Hatch a Codogotchi — generate a pet with Codex"
  description="hatch-codogotchi is a Codex plugin that generates a complete animated Codogotchi from a text description, an existing Codex pet, or a seed image."
>
  <section class="max-w-5xl mx-auto px-6 pt-12 pb-6 text-center flex flex-col items-center gap-5">
    <div class="hatch-hero relative w-60 h-60 md:w-72 md:h-72 flex items-center justify-center">
      <div
        class="relative w-48 h-48 md:w-56 md:h-56 rounded-full bg-surface-container-highest sticker-card overflow-hidden -rotate-2 z-10"
      >
        <img
          src="/assets/hatch-maew.webp"
          alt="Maew the Codogotchi bursting out of a cracked egg in a shower of golden sparkles"
          width="640"
          height="640"
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- sparkle storm: inline SVG, no icon font -->
      <svg class="sparkle text-gold-leaf" style="top:-6%;left:50%;width:34px;animation-delay:0s" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c1 7.2 3.8 10 11 12-7.2 1-10 3.8-11 12-1-8.2-3.8-11-11-12 7.2-2 10-4.8 11-12Z"/></svg>
      <svg class="sparkle text-gold-leaf" style="top:14%;left:-8%;width:22px;animation-delay:.5s" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c1 7.2 3.8 10 11 12-7.2 1-10 3.8-11 12-1-8.2-3.8-11-11-12 7.2-2 10-4.8 11-12Z"/></svg>
      <svg class="sparkle text-gold-leaf" style="top:6%;left:104%;width:28px;animation-delay:1.1s" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c1 7.2 3.8 10 11 12-7.2 1-10 3.8-11 12-1-8.2-3.8-11-11-12 7.2-2 10-4.8 11-12Z"/></svg>
      <svg class="sparkle text-gold-leaf" style="top:48%;left:-12%;width:16px;animation-delay:.8s" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c1 7.2 3.8 10 11 12-7.2 1-10 3.8-11 12-1-8.2-3.8-11-11-12 7.2-2 10-4.8 11-12Z"/></svg>
      <svg class="sparkle text-gold-leaf" style="top:52%;left:108%;width:20px;animation-delay:1.6s" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c1 7.2 3.8 10 11 12-7.2 1-10 3.8-11 12-1-8.2-3.8-11-11-12 7.2-2 10-4.8 11-12Z"/></svg>
      <svg class="sparkle text-gold-leaf" style="top:90%;left:8%;width:26px;animation-delay:.3s" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c1 7.2 3.8 10 11 12-7.2 1-10 3.8-11 12-1-8.2-3.8-11-11-12 7.2-2 10-4.8 11-12Z"/></svg>
      <svg class="sparkle text-gold-leaf" style="top:96%;left:54%;width:18px;animation-delay:1.3s" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c1 7.2 3.8 10 11 12-7.2 1-10 3.8-11 12-1-8.2-3.8-11-11-12 7.2-2 10-4.8 11-12Z"/></svg>
      <svg class="sparkle text-gold-leaf" style="top:86%;left:96%;width:24px;animation-delay:1.9s" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c1 7.2 3.8 10 11 12-7.2 1-10 3.8-11 12-1-8.2-3.8-11-11-12 7.2-2 10-4.8 11-12Z"/></svg>
      <svg class="sparkle text-gold-leaf" style="top:30%;left:96%;width:13px;animation-delay:.65s" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c1 7.2 3.8 10 11 12-7.2 1-10 3.8-11 12-1-8.2-3.8-11-11-12 7.2-2 10-4.8 11-12Z"/></svg>
      <svg class="sparkle text-gold-leaf" style="top:72%;left:-6%;width:13px;animation-delay:2.1s" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c1 7.2 3.8 10 11 12-7.2 1-10 3.8-11 12-1-8.2-3.8-11-11-12 7.2-2 10-4.8 11-12Z"/></svg>
    </div>
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-primary">
      Hatch a pet — no pixel-art skills required.
    </h1>
    <p class="text-on-surface-variant max-w-2xl">
      <code class="font-mono text-sm text-primary">hatch-codogotchi</code> is a plugin for the
      <strong>Codex desktop app</strong> that generates a complete, animated Codogotchi from a
      text description, an existing Codex pet, or a seed image. Codex renders every frame with
      its built-in image generation, one row at a time, self-validates each strip, writes
      <code class="font-mono text-sm text-primary">pet.json</code>, and installs it for you.
    </p>
    <p class="text-on-surface-variant text-sm max-w-2xl">
      Codex-only for now — the plugin relies on Codex's built-in <code
        class="font-mono text-xs text-primary">image_gen</code> tool, which other coding agents
      don't have.
    </p>
  </section>

  <!-- Install -->
  <section class="max-w-5xl mx-auto px-6 py-6 flex flex-col gap-4">
    <h2 class="font-display text-2xl font-bold text-center text-secondary">Install the plugin</h2>
    <p class="text-on-surface-variant text-center max-w-2xl mx-auto">
      The plugin and its skills live in the repo at
      <a
        href="https://github.com/cesarnml/codogotchi/tree/main/plugins/hatch-codogotchi"
        class="font-mono text-sm text-primary underline underline-offset-2"
        >plugins/hatch-codogotchi</a
      >. In the Codex desktop app, just paste:
    </p>
    <div class="menubar-inset rounded-xl p-5 relative group">
      <button
        class="absolute top-3 right-3 text-white/40 hover:text-gold-leaf transition-colors copy-btn"
        data-copy="Install the hatch-codogotchi plugin and its associated skills from https://github.com/cesarnml/codogotchi/tree/main/plugins/hatch-codogotchi"
        aria-label="Copy install prompt"
      >
        <span class="material-symbols-outlined text-[18px]">content_copy</span>
      </button>
      <code class="font-mono text-sm text-jade-sage break-words block leading-relaxed">
        Install the <span class="text-blush-pink">hatch-codogotchi</span> plugin and its
        associated skills from
        <span class="text-tertiary-fixed-dim">https://github.com/cesarnml/codogotchi/tree/main/plugins/hatch-codogotchi</span>
      </code>
    </div>
  </section>

  <!-- Three input paths -->
  <section class="max-w-5xl mx-auto px-6 py-8 grid md:grid-cols-3 gap-5">
    <div class="sticker-card bg-surface-bright rounded-2xl p-6 flex flex-col gap-3 -rotate-1">
      <div class="w-12 h-12 rounded-full bg-tertiary-container text-on-tertiary-container border-2 border-charcoal-ink flex items-center justify-center">
        <span class="material-symbols-outlined">chat</span>
      </div>
      <h2 class="font-display text-xl font-bold">Text description</h2>
      <p class="text-on-surface-variant text-sm">
        e.g. <em>"a chibi orange tabby in a tiny yellow hoodie, round head, warm pastel
        palette."</em> The character is designed during the run.
      </p>
    </div>
    <div class="sticker-card bg-surface-container-low rounded-2xl p-6 flex flex-col gap-3 rotate-1">
      <div class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container border-2 border-charcoal-ink flex items-center justify-center">
        <span class="material-symbols-outlined">pets</span>
      </div>
      <h2 class="font-display text-xl font-bold">Existing Codex pet</h2>
      <p class="text-on-surface-variant text-sm">
        Already have a native Codex pet in <code class="font-mono text-xs text-primary"
          >~/.codex/pets</code
        >? Codex extracts a reference frame from its spritesheet and stays on-model.
      </p>
    </div>
    <div class="sticker-card bg-surface-container-low rounded-2xl p-6 flex flex-col gap-3 -rotate-1">
      <div class="w-12 h-12 rounded-full bg-primary-container text-on-primary-container border-2 border-charcoal-ink flex items-center justify-center">
        <span class="material-symbols-outlined">image</span>
      </div>
      <h2 class="font-display text-xl font-bold">Seed image</h2>
      <p class="text-on-surface-variant text-sm">
        Drop a single <strong>192×208</strong> character image. Most consistent results — Codex
        extracts a reference and animates it across every state.
      </p>
    </div>
  </section>

  <!-- How it works -->
  <section class="max-w-5xl mx-auto px-6 py-6">
    <div class="sticker-card bg-inverse-on-surface rounded-2xl p-8">
      <h2 class="font-display text-2xl font-bold text-center text-secondary mb-8">How it works</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 relative">
        <div class="hidden lg:block absolute top-6 left-12 right-12 border-t-2 border-dashed border-charcoal-ink/40"></div>
        {
          steps.map((s) => (
            <div class="flex flex-col items-center text-center gap-2 relative z-10">
              <div class="w-12 h-12 rounded-full bg-surface border-2 border-charcoal-ink flex items-center justify-center text-primary font-display font-extrabold shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">
                {s.n}
              </div>
              <h3 class="font-bold text-on-surface">{s.title}</h3>
              <p class="text-sm text-on-surface-variant">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Canonical prompts -->
  <section class="max-w-5xl mx-auto px-6 py-6 flex flex-col gap-5">
    <h2 class="font-display text-2xl font-bold text-center text-secondary">
      Three ways to hatch — just ask Codex
    </h2>
    {
      prompts.map((p) => (
        <div class="menubar-inset rounded-xl p-5 relative group">
          <button
            class="absolute top-3 right-3 text-white/40 hover:text-gold-leaf transition-colors copy-btn"
            data-copy={p.copy}
            aria-label={`Copy prompt: ${p.title}`}
          >
            <span class="material-symbols-outlined text-[18px]">content_copy</span>
          </button>
          <div class="text-white/60 text-xs font-bold uppercase tracking-wide mb-2 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">{p.icon}</span>
            {p.title}
          </div>
          <code class="font-mono text-sm text-jade-sage break-words whitespace-pre-line block leading-relaxed pr-8">{p.copy}</code>
        </div>
      ))
    }

    <!-- The five skills -->
    <div class="sticker-card bg-surface-container rounded-2xl p-6 overflow-x-auto">
      <h3 class="font-display text-lg font-bold mb-3 flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">construction</span>
        The five skills
      </h3>
      <table class="w-full text-sm text-left">
        <thead>
          <tr class="text-on-surface-variant border-b-2 border-charcoal-ink/20">
            <th class="py-2 pr-4 font-bold">Skill</th>
            <th class="py-2 pr-4 font-bold">Starting point</th>
            <th class="py-2 font-bold">Produces</th>
          </tr>
        </thead>
        <tbody>
          {
            skills.map((s) => (
              <tr class="border-b border-charcoal-ink/10 last:border-0">
                <td class="py-2 pr-4">
                  <code class="font-mono text-xs text-primary">{s.name}</code>
                </td>
                <td class="py-2 pr-4 text-on-surface-variant">{s.from}</td>
                <td class="py-2 text-on-surface-variant">{s.makes}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- What you get -->
    <div class="sticker-card bg-surface-container rounded-2xl p-6">
      <h3 class="font-display text-lg font-bold mb-3 flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">inventory_2</span>
        What you get
      </h3>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="px-3 py-1.5 rounded-full border-2 border-charcoal-ink bg-surface-bright text-xs font-bold flex items-center gap-1 shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">
          <span class="material-symbols-outlined text-[14px]">image</span> spritesheet.webp
          <span class="text-on-surface-variant font-normal">· Tier 1 Codex 8×9</span>
        </span>
        <span class="px-3 py-1.5 rounded-full border-2 border-charcoal-ink bg-surface-bright text-xs font-bold flex items-center gap-1 shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">
          <span class="material-symbols-outlined text-[14px]">settings</span> codogotchi-lite-basic-spritesheet.webp
          <span class="text-on-surface-variant font-normal">· Tier 2 Lite-Basic 8×9</span>
        </span>
        <span class="px-3 py-1.5 rounded-full border-2 border-charcoal-ink bg-surface-bright text-xs font-bold flex items-center gap-1 shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">
          <span class="material-symbols-outlined text-[14px]">auto_awesome</span> codogotchi-lite-enhanced-spritesheet.webp
          <span class="text-on-surface-variant font-normal">· Tier 3 Lite-Enhanced 8×8</span>
        </span>
        <span class="px-3 py-1.5 rounded-full border-2 border-charcoal-ink bg-surface-bright text-xs font-bold flex items-center gap-1 shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">
          <span class="material-symbols-outlined text-[14px]">star</span> codogotchi-soa-spritesheet.webp
          <span class="text-on-surface-variant font-normal">· Tier 4 SoA 8×10</span>
        </span>
        <span class="px-3 py-1.5 rounded-full border-2 border-charcoal-ink bg-surface-bright text-xs font-bold flex items-center gap-1 shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">
          <span class="material-symbols-outlined text-[14px]">description</span> pet.json
        </span>
      </div>
      <p class="text-sm text-on-surface-variant">
        Start with <strong>Tier 1 + Tier 2 (Lite-Basic)</strong> — the gallery minimum bar.
        Add <strong>Tier 3 (Lite-Enhanced)</strong> for polish states like cramming, editing,
        and web-search. <strong>Tier 4 (SoA)</strong> is independent — hatch it anytime to
        light up delivery gates from
        <a
          href="https://github.com/cesarnml/son-of-anton"
          class="text-primary underline underline-offset-2"
          >Son-of-Anton</a
        >, a structured delivery orchestrator.
      </p>
    </div>
  </section>

  <!-- Cross links -->
  <section class="max-w-5xl mx-auto px-6 py-8 grid md:grid-cols-2 gap-5">
    <a href="/docs/spritesheet" class="sticker-card sticker-card-hover bg-blush-pink/30 rounded-2xl p-5 flex items-center justify-between rotate-1">
      <span class="font-bold flex items-center gap-2">
        <span class="material-symbols-outlined">menu_book</span>
        Prefer to draw it yourself? Spritesheet Reference
      </span>
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
    <a href="/pets" class="sticker-card sticker-card-hover bg-secondary-fixed/50 rounded-2xl p-5 flex items-center justify-between -rotate-1">
      <span class="font-bold flex items-center gap-2">
        <span class="material-symbols-outlined">photo_library</span>
        Browse the Gallery
      </span>
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
  </section>

  <style>
    .hatch-hero .sparkle {
      position: absolute;
      transform: translate(-50%, -50%) scale(0.4);
      opacity: 0;
      filter: drop-shadow(0 0 4px color-mix(in srgb, var(--color-gold-leaf, #d4af37) 60%, transparent));
      animation: sparkle-twinkle 2.6s ease-in-out infinite;
      will-change: transform, opacity;
    }
    @keyframes sparkle-twinkle {
      0%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(0.4) rotate(0deg); }
      50% { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(45deg); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hatch-hero .sparkle { animation: none; opacity: 0.9; transform: translate(-50%, -50%) scale(0.85); }
    }
  </style>

  <script>
    // astro:page-load re-wires copy buttons after every ClientRouter soft nav.
    document.addEventListener("astro:page-load", () => {
      document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const text = btn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(text);
            const icon = btn.querySelector("span");
            if (icon) {
              const prev = icon.textContent;
              icon.textContent = "check";
              setTimeout(() => (icon.textContent = prev), 1600);
            }
          } catch {}
        });
      });
    });
  </script>
</Base>
