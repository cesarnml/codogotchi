---
import Base from "../layouts/Base.astro";
import UploadApp from "../components/UploadApp";
---

<Base
  active="pets"
  title="Upload a pet — Codogotchi marketplace"
  description="Publish your own Codogotchi pet to the community gallery."
>
  <section class="max-w-7xl mx-auto px-6 pt-12 pb-2">
    <h1 class="font-display text-3xl md:text-4xl font-extrabold text-on-surface">
      Upload a pet
    </h1>
    <p class="text-on-surface-variant mt-2">
      Share a chibi companion with the community. We validate the package, repack
      it canonically, and list it in the gallery.
    </p>
  </section>

  <div class="squiggle max-w-7xl mx-auto w-full opacity-50 my-4"></div>

  <UploadApp client:only="react" />
</Base>
