---
import Base from "../layouts/Base.astro";

const updated = "June 7, 2026";

const toc = [
  { id: "what-we-collect", label: "What we collect" },
  { id: "how-we-use-it", label: "How we use it" },
  { id: "where-it-lives", label: "Where your data lives" },
  { id: "sharing", label: "Sharing & disclosure" },
  { id: "public-content", label: "Public content" },
  { id: "your-choices", label: "Your choices" },
  { id: "retention", label: "Retention & deletion" },
  { id: "contact", label: "Contact" },
];
---

<Base
  active=""
  title="Privacy Policy — Codogotchi"
  description="What Codogotchi collects when you sign in and upload pets, how it is used, and how to request deletion or a takedown."
>
  <div class="max-w-7xl w-full mx-auto px-6 py-8 flex flex-col md:flex-row gap-6">
    <!-- Sidebar -->
    <aside class="hidden md:block w-60 flex-shrink-0">
      <div class="sticker-card bg-surface-container-lowest rounded-2xl p-5 sticky top-24">
        <h3 class="font-display text-lg font-bold mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-secondary">shield</span>
          Privacy
        </h3>
        <ul class="flex flex-col gap-2">
          {
            toc.map((t) => (
              <li>
                <a
                  href={`#${t.id}`}
                  class="text-sm text-on-surface-variant hover:text-primary font-medium"
                >
                  {t.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>

    <!-- Content -->
    <div class="flex-grow min-w-0 flex flex-col gap-8">
      <!-- Hero -->
      <section
        class="sticker-card bg-surface-container-low rounded-2xl p-8 relative overflow-hidden"
      >
        <span
          class="material-symbols-outlined absolute -top-3 -right-3 text-6xl text-surface-variant opacity-40 rotate-12"
          >lock</span
        >
        <h1 class="font-display text-3xl md:text-4xl font-extrabold mb-3">
          Privacy Policy
        </h1>
        <p class="text-on-surface-variant max-w-2xl mb-2">
          Codogotchi is a small, owner-operated project. This policy describes the
          data we collect when you sign in and share pets in the
          <a href="/gallery" class="text-primary font-bold underline">gallery</a>,
          why we collect it, and how to remove it. We keep the surface small on
          purpose: no advertising, no third-party analytics or tracking.
        </p>
        <p class="text-xs text-on-surface-variant/70">Last updated: {updated}</p>
      </section>

      <!-- What we collect -->
      <section id="what-we-collect" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold mb-4">What we collect</h2>
        <div class="flex flex-col gap-4 text-on-surface-variant leading-relaxed">
          <div class="sticker-card bg-surface-container-lowest rounded-xl p-5">
            <h3 class="font-display font-bold text-on-surface mb-1">
              Account &amp; sign-in
            </h3>
            <p>
              You can sign in with Google, GitHub, or an email and password. When
              you use Google or GitHub, we receive your email address, display
              name, and avatar image from that provider. When you register with a
              password, we store your email address and a hashed password (handled
              by our authentication library — we never see your plaintext password)
              and send a one-time verification code to confirm the address. You
              also choose a public <strong>username</strong>.
            </p>
          </div>
          <div class="sticker-card bg-surface-container-lowest rounded-xl p-5">
            <h3 class="font-display font-bold text-on-surface mb-1">
              Pets you upload
            </h3>
            <p>
              When you publish a pet we store the package itself (a
              server-revalidated, re-packed <code class="font-mono text-sm text-primary"
                >.zip</code
              > of spritesheets and manifest), a generated thumbnail image, the
              display name and description you write, and the tiers the package
              contains. We also keep a running, aggregate
              <strong>download count</strong> per pet.
            </p>
          </div>
          <div class="sticker-card bg-surface-container-lowest rounded-xl p-5">
            <h3 class="font-display font-bold text-on-surface mb-1">
              What we do <em>not</em> collect
            </h3>
            <p>
              Downloading a pet via <code class="font-mono text-sm text-primary"
                >npx codogotchi add</code
              >, curl, or direct <code class="font-mono text-sm text-primary">.zip</code
              > does not require an account and is not tied to your identity — we
              count downloads in aggregate only. We do not run advertising or
              third-party analytics, and the gallery sets no tracking cookies. The
              desktop app's local RPG data stays on your machine under
              <code class="font-mono text-sm text-primary">~/.codogotchi</code> and
              is governed by the app, not this gallery.
            </p>
          </div>
        </div>
      </section>

      <!-- How we use it -->
      <section id="how-we-use-it" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold mb-4">How we use it</h2>
        <ul
          class="flex flex-col gap-2 text-on-surface-variant leading-relaxed list-disc pl-5"
        >
          <li>To authenticate you and keep you signed in.</li>
          <li>To attribute pets you upload to your public username.</li>
          <li>To host, validate, and serve pet packages for download.</li>
          <li>
            To send transactional email — only the email-verification code for
            password sign-up. We do not send marketing email.
          </li>
          <li>
            To operate the service safely: moderating reported content and
            honoring takedowns.
          </li>
        </ul>
      </section>

      <!-- Where it lives -->
      <section id="where-it-lives" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold mb-4">Where your data lives</h2>
        <p class="text-on-surface-variant leading-relaxed">
          Accounts, pet metadata, and uploaded files are stored on
          <a
            href="https://www.convex.dev"
            class="text-primary font-bold underline"
            rel="noopener noreferrer"
            target="_blank">Convex</a
          > (database and file storage). Email verification codes are delivered
          through <a
            href="https://resend.com"
            class="text-primary font-bold underline"
            rel="noopener noreferrer"
            target="_blank">Resend</a
          >. Sign-in is handled by Google, GitHub, or our own password provider
          depending on the method you choose. These providers process your data on
          our behalf under their own privacy terms.
        </p>
      </section>

      <!-- Sharing -->
      <section id="sharing" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold mb-4">Sharing &amp; disclosure</h2>
        <p class="text-on-surface-variant leading-relaxed">
          We do not sell your personal data and we do not share it with
          advertisers. We share data only with the infrastructure providers listed
          above so the service can run, and we may disclose information if required
          by law or to respond to a valid legal request, or to address security,
          fraud, or abuse.
        </p>
      </section>

      <!-- Public content -->
      <section id="public-content" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold mb-4">Public content</h2>
        <p class="text-on-surface-variant leading-relaxed">
          Anything tied to a published pet is <strong>public</strong>: your
          username, the pet's display name and description, its thumbnail and
          animation frames, and the downloadable package. Do not put information in
          a pet, username, or description that you would not want shown publicly.
        </p>
      </section>

      <!-- Your choices -->
      <section id="your-choices" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold mb-4">Your choices</h2>
        <ul
          class="flex flex-col gap-2 text-on-surface-variant leading-relaxed list-disc pl-5"
        >
          <li>You can browse and install pets without an account.</li>
          <li>
            You can request deletion of your account and uploaded pets by emailing
            us (see below).
          </li>
          <li>
            You can request that a specific pet be unlisted or removed — yours or
            one that infringes your rights.
          </li>
        </ul>
      </section>

      <!-- Retention -->
      <section id="retention" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold mb-4">Retention &amp; deletion</h2>
        <p class="text-on-surface-variant leading-relaxed">
          We keep account and pet data for as long as the account is active. The
          operator can unlist any pet instantly, which immediately removes it from
          the gallery and download endpoints. On a deletion request we remove your
          account record and the pet packages you uploaded. Aggregate, non-identifying
          counts may persist.
        </p>
      </section>

      <!-- Contact -->
      <section id="contact" class="scroll-mt-24">
        <div
          class="bg-primary-fixed text-on-primary-fixed-variant rounded-xl border-2 border-charcoal-ink p-5 flex items-start gap-3"
        >
          <span class="material-symbols-outlined">mail</span>
          <p class="text-sm">
            Questions, deletion requests, or takedowns:
            <a href="mailto:admin@codogotchi.app" class="font-bold underline"
              >admin@codogotchi.app</a
            >. See also our <a href="/terms" class="font-bold underline">Terms</a
            >.
          </p>
        </div>
      </section>
    </div>
  </div>
</Base>
