---
import Base from "../layouts/Base.astro";
import HeroDemo from "../components/HeroDemo.astro";
// Fingerprinted via ?url so immutable caches bust on update (see public-asset
// cache-bust gotcha). Wide = 16:9 desktop, square = 1:1 mobile.
import perfWide from "../assets/perf-comparison-wide.webp?url";
import perfSquare from "../assets/perf-comparison-square.webp?url";

const ways = [
  {
    icon: "favorite",
    color: "bg-primary-container text-on-primary-container",
    title: "Meet Maew",
    body: "The charming default pet who ships with the app. A cute-flirty buddy in a white sundress, animated across all 19 agent states out of the box.",
    cta: "Meet her",
    href: "/gallery#maew",
  },
  {
    icon: "auto_awesome",
    color: "bg-tertiary-container text-on-tertiary-container",
    title: "Hatch your own with AI",
    body: "Describe a pet or drop a seed image and your agent generates a full animated spritesheet for you — one row at a time — via the hatch-codogotchi skill.",
    cta: "Hatch a pet",
    href: "/hatch",
  },
  {
    icon: "groups",
    color: "bg-secondary-container text-on-secondary-container",
    title: "Browse the gallery",
    body: "Browse pets hatched and hand-drawn by other developers, then drop the folder into ~/.codogotchi/pets/ and switch to it in Settings → Pet.",
    cta: "Browse the gallery",
    href: "/gallery",
  },
  {
    icon: "draw",
    color: "bg-jade-sage/40 text-on-surface",
    title: "Bring your own spritesheet",
    body: "Hand-draw a Codex-compatible sheet using the reference spec — an 8-column grid with a 192×208 cell. Tier 1 is all you need to start.",
    cta: "Read the spec",
    href: "/docs/spritesheet",
  },
];

const features = [
  {
    icon: "bolt",
    title: "Reacts to your agent",
    body: "The pet's animation changes per activity — implementing, testing, thinking, reading, cramming, errored, standby. 19 states driven by real lifecycle hooks, not a spinner.",
  },
  {
    icon: "layers",
    title: "Tiered spritesheets",
    body: "Tier 1 (Codex 8×9) is the required base. Tier 2 (Lite-Basic 8×9) adds per-activity art. Tier 3 (Lite-Enhanced 8×8) adds polish states. Tier 4 (Son-of-Anton 8×10) lights up delivery gates.",
  },
  {
    icon: "stadia_controller",
    title: "RPG layer (coming soon)",
    body: "Your pet already earns levels and half-hearts from real coding activity. XP, leaderboards, and a social feed are on the way — free, no pay-to-win.",
    soon: true,
  },
];

const platforms = [
  "Claude Code",
  "Codex",
  "Cursor",
  "Copilot (VS Code)",
  "Antigravity",
];
---

<Base active="">
  <!-- HERO -->
  <section class="max-w-7xl mx-auto px-6 pt-12 pb-8">
    <div class="grid lg:grid-cols-2 gap-10 items-center">
      <div class="flex flex-col gap-6">
        <div
          class="inline-flex items-center gap-2 w-max bg-gold-leaf/20 border-2 border-gold-leaf text-on-secondary-fixed-variant px-3 py-1 rounded-full text-xs font-bold -rotate-1"
        >
          <span class="material-symbols-outlined text-[14px] text-gold-leaf">pets</span>
          Lives in your macOS menubar
        </div>
        <h1 class="font-display text-4xl md:text-5xl font-extrabold text-on-surface leading-[1.1]">
          Your AI agent <span class="text-primary">deserves a pet.</span>
        </h1>
        <p class="text-on-surface-variant text-lg max-w-lg">
          Codogotchi lives in your menubar and animates in real time to what your
          agent is doing — coding, thinking, testing, erroring, waiting. A cute
          little buddy inside your workflow.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/download"
            class="squishy-btn bg-primary-container text-on-primary-container font-display font-bold px-6 py-3 rounded-full flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-[20px]">download</span>
            Download for macOS
          </a>
          <a
            href="/hatch"
            class="squishy-btn bg-surface-bright text-primary font-display font-bold px-6 py-3 rounded-full flex items-center gap-2"
          >
            Hatch your own
            <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant mr-1"
            >Works with</span
          >
          {
            platforms.map((p) => (
              <span class="px-3 py-1 rounded-full border border-charcoal-ink/40 bg-surface-bright text-xs font-medium">
                {p}
              </span>
            ))
          }
        </div>
      </div>

      <HeroDemo />
    </div>
  </section>

  <div class="squiggle max-w-7xl mx-auto w-full opacity-50 my-6"></div>

  <!-- FOUR WAYS -->
  <section class="max-w-7xl mx-auto px-6 py-10">
    <div class="text-center mb-10">
      <h2 class="font-display text-3xl md:text-4xl font-extrabold text-on-surface">
        Four ways to get a pet
      </h2>
      <p class="text-on-surface-variant mt-2">
        Start with Maew, hatch something new, adopt a buddy, or draw your own.
      </p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        ways.map((w, idx) => (
          <a
            href={w.href}
            class={`sticker-card sticker-card-hover bg-surface-container-lowest rounded-2xl p-6 flex flex-col gap-3 ${idx % 2 ? "-rotate-1" : "rotate-1"}`}
          >
            <div
              class={`w-12 h-12 rounded-full flex items-center justify-center border-2 border-charcoal-ink ${w.color}`}
            >
              <span class="material-symbols-outlined">{w.icon}</span>
            </div>
            <h3 class="font-display text-lg font-bold text-on-surface">{w.title}</h3>
            <p class="text-sm text-on-surface-variant flex-grow">{w.body}</p>
            <span class="text-sm font-bold text-primary flex items-center gap-1 mt-2">
              {w.cta}
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- FEATURES -->
  <section class="max-w-7xl mx-auto px-6 py-10">
    <div class="grid md:grid-cols-3 gap-5">
      {
        features.map((f) => (
          <div class="sticker-card bg-surface-container-low rounded-2xl p-6 flex flex-col gap-3 relative overflow-hidden">
            <span class="material-symbols-outlined absolute -top-3 -right-3 text-6xl text-outline-variant opacity-30 rotate-12">
              local_florist
            </span>
            <div class="w-12 h-12 rounded-2xl bg-surface-bright border-2 border-charcoal-ink flex items-center justify-center text-primary">
              <span class="material-symbols-outlined">{f.icon}</span>
            </div>
            <h3 class="font-display text-lg font-bold text-on-surface flex items-center gap-2">
              {f.title}
              {f.soon && (
                <span class="text-[10px] uppercase font-bold bg-gold-leaf/30 border border-gold-leaf text-on-secondary-fixed-variant px-2 py-0.5 rounded-full">
                  soon
                </span>
              )}
            </h3>
            <p class="text-sm text-on-surface-variant">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PERFORMANCE COMPARISON -->
  <section class="max-w-7xl mx-auto px-6 py-10">
    <div class="flex flex-col gap-5 items-center text-center">
      <h2 class="font-display text-3xl md:text-4xl font-extrabold text-on-surface">
        Native. It barely touches your Mac.
      </h2>
      <p class="text-on-surface-variant max-w-2xl">
        We ran Codogotchi next to the popular Electron-based alternative on the
        same Mac, reacting to the same coding session. Swift + SpriteKit stays
        light and lively; a bundled browser engine doesn't.
      </p>
      <picture>
        <source
          media="(min-width: 768px)"
          srcset={perfWide}
          width="1600"
          height="900"
        />
        <img
          src={perfSquare}
          width="1080"
          height="1080"
          loading="lazy"
          decoding="async"
          alt="Live comparison on the same Mac: Codogotchi reacted 2.7× more often (16 animations vs 6) while using ~5× less memory (45 MB vs 218 MB), up to ~16× less CPU (~3% vs ~44%), ~6× less energy, a 3.2× smaller app (130 MB vs 417 MB), and a single process vs four."
          class="w-full h-auto rounded-3xl border-2 border-charcoal-ink sticker-card"
        />
      </picture>
      <p class="text-xs text-on-surface-variant">
        Measured live on the same Mac (Apple M1 Pro) while both pets reacted to
        the same coding session. Codogotchi v1.1.0 vs OpenPets v3.1.0.
      </p>
    </div>
  </section>

  <!-- INSTALL -->
  <section class="max-w-5xl mx-auto px-6 py-12" id="install-guide">
    <div class="sticker-card bg-surface-container rounded-3xl p-8 md:p-10 flex flex-col gap-6">
      <div class="flex flex-col md:flex-row md:items-center gap-3">
        <h2 class="font-display text-2xl md:text-3xl font-extrabold text-on-surface">
          Install Codogotchi
        </h2>
        <span
          class="w-max text-xs font-bold uppercase bg-tertiary-container text-on-tertiary-container border-2 border-charcoal-ink px-3 py-1 rounded-full"
        >
          macOS · arm64
        </span>
      </div>

      <!-- Steps -->
      <div class="flex flex-col gap-5">
        <div class="flex gap-4 items-start">
          <div class="w-8 h-8 flex-shrink-0 rounded-full bg-primary-container text-on-primary-container border-2 border-charcoal-ink flex items-center justify-center font-display font-extrabold text-sm shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">1</div>
          <p class="pt-0.5 text-on-surface">
            <a href="/download" class="font-bold text-primary underline">Download Codogotchi.dmg</a>
            — open it and drag <strong>Codogotchi</strong> to <code class="font-mono text-sm">/Applications</code>.
          </p>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-8 h-8 flex-shrink-0 rounded-full bg-primary-container text-on-primary-container border-2 border-charcoal-ink flex items-center justify-center font-display font-extrabold text-sm shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">2</div>
          <div class="flex flex-col gap-2 flex-1">
            <p class="text-on-surface">Clear the quarantine flag <span class="text-on-surface-variant text-sm">(unsigned build — one-time)</span></p>
            <div class="menubar-inset rounded-xl p-4 font-mono text-sm text-jade-sage">
              xattr -cr /Applications/Codogotchi.app
            </div>
          </div>
        </div>
        <div class="flex gap-4 items-start">
          <div class="w-8 h-8 flex-shrink-0 rounded-full bg-primary-container text-on-primary-container border-2 border-charcoal-ink flex items-center justify-center font-display font-extrabold text-sm shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">3</div>
          <p class="pt-0.5 text-on-surface">
            Launch and approve the <strong>Welcome to Codogotchi</strong> consent sheet — installs
            hooks for Claude Code, Codex, Cursor, Copilot &amp; Antigravity. No Terminal required after this.
          </p>
        </div>
      </div>

      <a
        href="/download"
        class="squishy-btn self-start bg-primary text-on-primary font-display font-bold px-8 py-3 rounded-full flex items-center gap-2 shadow-[3px_3px_0_0_var(--color-charcoal-ink)]"
      >
        <span class="material-symbols-outlined text-[20px]">download</span>
        Download Codogotchi.dmg
      </a>
    </div>
  </section>
</Base>
