---
import Base from "../layouts/Base.astro";
import { API_BASE as CONVEX_SITE } from "../lib/convexEnv";

const GITHUB_RELEASE_URL =
  "https://github.com/cesarnml/codogotchi/releases/latest/download/Codogotchi.dmg";
const VERSION = "2.6.0";
---

<Base
  active=""
  title="Download Codogotchi — macOS menubar pet"
  description="Download Codogotchi for macOS. Drag to Applications, clear the quarantine flag, and your agent gets a pet."
>
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-8 flex flex-col items-center gap-8 text-center">
    <!-- Badge -->
    <div class="relative w-32 h-32 rounded-full bg-surface-container-highest sticker-card flex items-center justify-center overflow-hidden -rotate-2">
      <img
        src="/assets/hatch-maew-badge.webp"
        alt="Maew hatching from an egg"
        width="128"
        height="128"
        class="w-full h-full object-cover"
        decoding="async"
      />
      <span class="material-symbols-outlined absolute top-3 right-4 text-2xl text-gold-leaf">download</span>
    </div>

    <div class="flex flex-col items-center gap-3">
      <div class="flex items-center gap-2">
        <h1 class="font-display text-3xl md:text-4xl font-extrabold text-on-surface">
          Download Codogotchi
        </h1>
        <span class="text-xs font-bold font-mono bg-surface-container border-2 border-charcoal-ink px-2 py-1 rounded-full shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">
          v{VERSION}
        </span>
      </div>
      <p class="text-on-surface-variant max-w-md">
        macOS menubar app · arm64 · not yet notarized — one extra step below.
      </p>
    </div>

    <!-- Primary CTA -->
    <a
      href={GITHUB_RELEASE_URL}
      id="dmg-download-btn"
      class="squishy-btn bg-primary text-on-primary font-display font-bold text-lg px-10 py-4 rounded-full flex items-center gap-3 shadow-[4px_4px_0_0_var(--color-charcoal-ink)]"
    >
      <span class="material-symbols-outlined text-[24px]">download</span>
      Download Codogotchi.dmg
    </a>

    <p class="text-xs text-on-surface-variant -mt-4">
      Hosted on GitHub Releases ·
      <a
        href="https://github.com/cesarnml/codogotchi/releases"
        class="underline hover:text-primary"
        target="_blank"
        rel="noopener noreferrer">all releases</a
      >
    </p>
  </section>

  <!-- Install steps -->
  <section class="max-w-3xl mx-auto px-6 py-8">
    <div class="sticker-card bg-surface-container rounded-3xl p-8 flex flex-col gap-6">
      <h2 class="font-display text-2xl font-bold text-on-surface">Install in 3 steps</h2>

      <!-- Step 1 -->
      <div class="flex gap-4">
        <div class="w-9 h-9 flex-shrink-0 rounded-full bg-primary-container text-on-primary-container border-2 border-charcoal-ink flex items-center justify-center font-display font-extrabold shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">1</div>
        <div class="flex flex-col gap-1">
          <p class="font-bold text-on-surface">Open the DMG and drag Codogotchi to Applications</p>
          <p class="text-sm text-on-surface-variant">Standard macOS drag-and-drop install.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex gap-4">
        <div class="w-9 h-9 flex-shrink-0 rounded-full bg-primary-container text-on-primary-container border-2 border-charcoal-ink flex items-center justify-center font-display font-extrabold shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">2</div>
        <div class="flex flex-col gap-2">
          <p class="font-bold text-on-surface">Clear the quarantine flag</p>
          <p class="text-sm text-on-surface-variant mb-1">
            The build isn't notarized yet — macOS quarantines unsigned downloads. Run this once
            in Terminal, then double-click to launch normally from then on.
          </p>
          <div class="menubar-inset rounded-xl p-4 relative group">
            <button
              class="absolute top-2 right-2 text-white/40 hover:text-gold-leaf transition-colors copy-btn"
              data-copy="xattr -d com.apple.quarantine /Applications/Codogotchi.app"
              aria-label="Copy command"
            >
              <span class="material-symbols-outlined text-[18px]">content_copy</span>
            </button>
            <code class="font-mono text-sm text-jade-sage">
              xattr -d com.apple.quarantine /Applications/Codogotchi.app
            </code>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex gap-4">
        <div class="w-9 h-9 flex-shrink-0 rounded-full bg-primary-container text-on-primary-container border-2 border-charcoal-ink flex items-center justify-center font-display font-extrabold shadow-[2px_2px_0_0_var(--color-charcoal-ink)]">3</div>
        <div class="flex flex-col gap-1">
          <p class="font-bold text-on-surface">Approve the welcome sheet</p>
          <p class="text-sm text-on-surface-variant">
            On first launch Codogotchi asks to install hooks for Claude Code, Codex, Cursor,
            Copilot (VS Code), and Antigravity. Approve once — no Terminal commands required.
            Manage hooks anytime in <strong>Settings → General</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cross links -->
  <section class="max-w-3xl mx-auto px-6 pb-16 grid sm:grid-cols-2 gap-5">
    <a
      href="/gallery"
      class="sticker-card sticker-card-hover bg-secondary-fixed/50 rounded-2xl p-5 flex items-center justify-between"
    >
      <span class="font-bold flex items-center gap-2">
        <span class="material-symbols-outlined">photo_library</span>
        Browse the pet gallery
      </span>
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
    <a
      href="/hatch"
      class="sticker-card sticker-card-hover bg-blush-pink/30 rounded-2xl p-5 flex items-center justify-between"
    >
      <span class="font-bold flex items-center gap-2">
        <span class="material-symbols-outlined">auto_awesome</span>
        Hatch your own pet
      </span>
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
  </section>

  <script>
    // astro:page-load re-wires copy buttons after every ClientRouter soft nav.
    document.addEventListener("astro:page-load", () => {
      document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const text = btn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(text);
            const icon = btn.querySelector("span");
            if (icon) {
              const prev = icon.textContent;
              icon.textContent = "check";
              setTimeout(() => (icon.textContent = prev), 1600);
            }
          } catch {}
        });
      });
    });
  </script>

  <script is:inline define:vars={{ CONVEX_SITE }}>
    document.addEventListener("astro:page-load", () => {
      document
        .getElementById("dmg-download-btn")
        ?.addEventListener("click", () => {
          fetch(`${CONVEX_SITE}/track-dmg-download`, { method: "POST" }).catch(
            () => {},
          );
        });
    });
  </script>
</Base>
