---
import Base from "../layouts/Base.astro";
import StudioApp from "../components/studio/StudioApp";
---

<Base
  active="studio"
  title="Codogotchi Studio — chroma-key your spritesheets to transparent WebP"
  description="Key out the flat background from a Codogotchi spritesheet and export a transparent WebP — fully in your browser. Tune tolerance, edge smoothness, and spill suppression."
>
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-12 pb-6">
    <div class="max-w-2xl flex flex-col gap-2">
      <div
        class="inline-flex items-center gap-2 w-max bg-tertiary-container/30 border-2 border-charcoal-ink text-on-surface px-3 py-1 rounded-full text-xs font-bold -rotate-2"
      >
        <span class="material-symbols-outlined text-[14px] text-tertiary">colorize</span>
        Client-side keying ✨
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-extrabold text-on-surface">
        Codogotchi Studio
      </h1>
      <p class="text-on-surface-variant">
        Drop a keyed spritesheet, dial in the matte, and export a
        transparent <strong>WebP</strong> — ready to install. Every pixel is
        processed locally in your browser; nothing is uploaded.
      </p>
    </div>
  </section>

  <div class="squiggle max-w-7xl mx-auto w-full opacity-50 my-4"></div>

  <section class="max-w-7xl mx-auto px-6 pb-16 w-full">
    <StudioApp client:only="react" />
  </section>
</Base>
