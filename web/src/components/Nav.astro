---
import AuthWidget from "./AuthWidget";

interface Props {
  active?: string;
}
const { active = "" } = Astro.props;

const links = [
  { href: "/hatch", label: "Hatch", key: "hatch" },
  { href: "/gallery", label: "Gallery", key: "pets" },
  { href: "/studio", label: "Studio", key: "studio" },
  { href: "/docs/spritesheet", label: "Docs", key: "docs" },
  { href: "/rpg", label: "RPG", key: "rpg", lock: true },
];
---

<nav
  class="bg-surface/90 backdrop-blur-md sticky top-0 w-full z-50 border-b-2 border-charcoal-ink shadow-[0_4px_0_0_var(--color-charcoal-ink)]"
>
  <div
    class="flex justify-between items-center px-6 pt-4 pb-3 max-w-7xl mx-auto"
  >
    <a
      href="/"
      class="font-display text-xl md:text-2xl text-primary font-extrabold flex items-center gap-2 hover:scale-105 transition-transform shrink-0"
    >
      <img
        src="/assets/codogotchi-logo.webp"
        alt=""
        width="40"
        height="40"
        class="size-10 rounded-full border-2 border-primary/25 object-cover bg-surface-bright"
        loading="eager"
        decoding="async"
      />
      Codogotchi
    </a>

    <div class="hidden md:flex items-center gap-7">
      {
        links.map((l) => (
          <a
            href={l.href}
            class={`font-medium transition-transform hover:scale-105 hover:text-primary flex items-center gap-1 ${
              active === l.key
                ? "text-primary font-bold border-b-2 border-primary"
                : "text-on-surface-variant"
            }`}
          >
            {l.label}
            {l.lock && <span class="text-xs opacity-70">🔒</span>}
          </a>
        ))
      }
    </div>

    <!-- Single AuthWidget for all viewports: each instance mounts its own
         ConvexAuthProvider, and two providers racing setAuth on the shared
         client leaves one stuck in isLoading (blank widget). Keep exactly one. -->
    <!-- min-h-11 reserves the hydrated AuthWidget button height (44px) so the
         nav doesn't grow and push the page down when the island mounts (CLS). -->
    <div class="flex items-center gap-3 min-h-11">
      <AuthWidget client:only="react" transition:persist />
      <button class="md:hidden text-charcoal-ink" aria-label="Menu" id="menu-toggle">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden hidden flex-col gap-1 px-6 pb-4 border-t-2 border-charcoal-ink/20"
  >
    {
      links.map((l) => (
        <a
          href={l.href}
          class={`py-2 font-medium ${active === l.key ? "text-primary font-bold" : "text-on-surface-variant"}`}
        >
          {l.label}
          {l.lock && <span class="text-xs opacity-70"> 🔒</span>}
        </a>
      ))
    }
  </div>
</nav>

<script>
  // astro:page-load fires on first load AND after every ClientRouter soft
  // navigation, re-wiring the freshly-swapped nav DOM each time.
  document.addEventListener("astro:page-load", () => {
    const t = document.getElementById("menu-toggle");
    const m = document.getElementById("mobile-menu");
    t?.addEventListener("click", () => {
      m?.classList.toggle("hidden");
      m?.classList.toggle("flex");
    });
  });
</script>
