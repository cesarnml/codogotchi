---
interface Props {
  active?: string;
}
const { active = "" } = Astro.props;

const links = [
  { href: "/download", label: "Download", key: "download" },
  { href: "/docs/spritesheet", label: "Docs", key: "docs" },
  { href: "/hatch", label: "Hatch a Pet", key: "hatch" },
  { href: "/gallery", label: "Gallery", key: "pets" },
  {
    href: "https://github.com/cesarnml/codogotchi",
    label: "GitHub",
    key: "gh",
  },
  {
    href: "https://codogotchifordummies.vercel.app",
    label: "Dev Guide",
    key: "devguide",
  },
  { href: "/rpg", label: "RPG 🔒", key: "rpg" },
  { href: "/privacy", label: "Privacy", key: "privacy" },
  { href: "/terms", label: "Terms", key: "terms" },
];
---

<footer
  class="w-full mt-16 pt-10 pb-8 bg-surface-container-lowest border-t-2 border-dashed border-charcoal-ink"
>
  <div class="squiggle w-full max-w-7xl mx-auto mb-8 opacity-60"></div>
  <div class="flex flex-col items-center gap-6 px-6 w-full max-w-7xl mx-auto">
    <a
      href="/"
      class="font-display text-2xl text-primary font-extrabold flex items-center gap-2"
    >
      <img
        src="/assets/codogotchi-logo.webp"
        alt=""
        width="40"
        height="40"
        class="size-10 rounded-full border-2 border-primary/25 object-cover bg-surface-bright"
        loading="lazy"
        decoding="async"
      />
      Codogotchi
    </a>
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
      {
        links.map((l) => (
          <a
            href={l.href}
            class={`font-body hover:text-primary transition-colors ${active === l.key ? "text-primary font-bold" : "text-on-surface-variant"}`}
          >
            {l.label}
          </a>
        ))
      }
    </div>
    <div class="flex items-center justify-center gap-4">
      <a
        href="https://x.com/codogotchi"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Codogotchi on X"
        class="text-on-surface-variant hover:text-primary transition-colors"
      >
        <svg
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path>
        </svg>
      </a>
      <a
        href="https://www.instagram.com/codogotchi"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Codogotchi on Instagram"
        class="text-on-surface-variant hover:text-primary transition-colors"
      >
        <svg
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.012-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.332.014 7.052.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.332 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
          ></path>
        </svg>
      </a>
    </div>
    <p class="text-sm text-on-surface-variant text-center max-w-md">
      Works with Claude Code · Codex · Cursor · Copilot · Antigravity.
      Your little buddy who codes with you.
    </p>
    <p class="text-xs text-on-surface-variant/70 text-center max-w-lg leading-relaxed">
      Gallery pets are community-shared and may be inspired by existing characters
      or brands. Codogotchi does not claim rights to any character designs shown
      there. Takedowns: <a
        href="mailto:admin@codogotchi.app"
        class="hover:text-primary underline">admin@codogotchi.app</a
      >.
    </p>
    <p class="text-xs text-on-surface-variant/70 text-center flex items-center gap-1">
      Made with ☕ and 🫶 in 🇹🇭
    </p>
  </div>
</footer>
