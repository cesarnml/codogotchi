---
import "@fontsource/plus-jakarta-sans/500.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";
import "@fontsource/be-vietnam-pro/400.css";
import "@fontsource/be-vietnam-pro/500.css";
import "@fontsource/be-vietnam-pro/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";
// Preloaded below so above-the-fold text/icons don't reflow when fonts swap
// in (font-swap CLS). Keep in sync with the families used in the hero/nav.
import jakarta700Url from "@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-700-normal.woff2?url";
import jakarta800Url from "@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-800-normal.woff2?url";
import vietnam400Url from "@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-400-normal.woff2?url";
import vietnam500Url from "@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-500-normal.woff2?url";
import vietnam700Url from "@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-700-normal.woff2?url";
import mono400Url from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
// Self-hosted Material Symbols subset. Imported (not a literal public/ path) so
// Vite fingerprints the URL — regenerating the subset emits a new filename and
// busts the long-lived `immutable` cache, instead of pinning stale icon sets.
import msSubsetUrl from "../assets/material-symbols-subset.woff2?url";
const preloadFonts = [
  jakarta700Url,
  jakarta800Url,
  vietnam400Url,
  vietnam500Url,
  vietnam700Url,
  mono400Url,
  msSubsetUrl,
];
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  active?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title = "Codogotchi — macOS menubar pet for Claude Code, Codex, Cursor & Copilot",
  description = "Codogotchi is a free macOS menubar pet for AI coding agents — Claude Code, Codex, Cursor, GitHub Copilot, and Antigravity. Your pet animates in real time as your agent codes, thinks, tests, and idles. A developer Tamagotchi for your workflow.",
  active = "",
  image = "/og-image.png",
  imageAlt = "Codogotchi hatch artwork with Maew emerging from an egg.",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://codogotchi.app");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Codogotchi",
    url: new URL("/", site).toString(),
    description:
      "Codogotchi is a free macOS menubar pet for AI coding agents — Claude Code, Codex, Cursor, GitHub Copilot, and Antigravity. An open-source developer Tamagotchi and alternative to OpenPets.",
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Codogotchi",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS",
    url: new URL("/", site).toString(),
    description,
    image: imageUrl,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    {/* Suppress browser "Leave site?" dialogs. @convex-dev/auth's
        ConvexAuthProvider registers a beforeunload handler that fires whenever a
        JWT refresh is in flight — independent of the convex client's
        unsavedChangesWarning:false (see lib/convex.ts). A capture-phase listener
        runs before that bubble-phase one and stops it. window persists across
        ClientRouter soft navigations, so registering once is enough. No page
        here has unsaved user state riding on a background mutation. */}
    <script is:inline>
      window.addEventListener(
        "beforeunload",
        (e) => e.stopImmediatePropagation(),
        true,
      );
    </script>
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    {
      preloadFonts.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
      ))
    }
    <style
      set:html={`@font-face{font-family:"Material Symbols Outlined";font-style:normal;font-weight:100 700;font-display:block;src:url("${msSubsetUrl}") format("woff2");}`}
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta
      name="keywords"
      content="Codogotchi, Codex pets, OpenPets alternative, AI coding pet, desktop pet, AI coding agent, developer Tamagotchi, coding companion, macOS menubar pet, Claude Code pet, Codex, Cursor pet, GitHub Copilot pet, Antigravity, AI agent companion, coding Tamagotchi, open source coding pet, macOS developer tool"
    />
    <meta name="application-name" content="Codogotchi" />
    <meta name="author" content="Codogotchi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Codogotchi" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#fff8f0" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav active={active} />
    <main class="flex-grow w-full">
      <slot />
    </main>
    <Footer active={active} />
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
    <script>
      // Wires every `.copy-btn` on the site: copies its `data-copy` payload and
      // flashes a check icon. Lives in the layout so pages only ship the markup.
      // astro:page-load re-runs after each ClientRouter soft nav; the bound flag
      // keeps persisted elements from stacking duplicate listeners.
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
          if (btn.dataset.copyBound) return;
          btn.dataset.copyBound = "true";
          btn.addEventListener("click", async () => {
            const text = btn.getAttribute("data-copy") || "";
            try {
              await navigator.clipboard.writeText(text);
              const icon = btn.querySelector("span");
              if (icon) {
                const prev = icon.textContent;
                icon.textContent = "check";
                setTimeout(() => (icon.textContent = prev), 1600);
              }
            } catch {}
          });
        });
      });
    </script>
    <SpeedInsights />
  </body>
</html>
