---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  active?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title = "Codogotchi — a cute desktop pet for your AI coding agent",
  description = "Codogotchi lives in your macOS menubar and animates in real time to what your agent is doing — coding, thinking, testing, erroring, waiting. A cute little buddy inside your workflow.",
  active = "",
  image = "/og-image.png",
  imageAlt = "Codogotchi hatch artwork with Maew emerging from an egg.",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://codogotchi.app");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Codogotchi",
    url: new URL("/", site).toString(),
    description:
      "Codogotchi is a macOS menubar pet for AI coding agents including Codex, Claude Code, Cursor, Copilot, and Antigravity.",
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Codogotchi",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS",
    url: new URL("/", site).toString(),
    description,
    image: imageUrl,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta
      name="keywords"
      content="Codogotchi, desktop pet, AI coding agent, Codex, Claude Code, Cursor, Copilot, Antigravity, macOS menubar pet"
    />
    <meta name="application-name" content="Codogotchi" />
    <meta name="author" content="Codogotchi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Codogotchi" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#fff8f0" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Be+Vietnam+Pro:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav active={active} />
    <main class="flex-grow w-full">
      <slot />
    </main>
    <Footer active={active} />
  </body>
</html>
